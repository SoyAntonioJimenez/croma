<Window x:Class="FolderHue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:FolderHue.App"
        Title="Croma" Height="792" Width="1040" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ───────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Croma" FontSize="14.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="7,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="2"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangEn" Content="EN" GroupName="lang"
                                         Style="{StaticResource ChoiceChip}" Margin="0" Padding="9,3"
                                         FontSize="11.5" Click="Language_Click"/>
                            <RadioButton x:Name="LangEs" Content="ES" GroupName="lang"
                                         Style="{StaticResource ChoiceChip}" Margin="0" Padding="9,3"
                                         FontSize="11.5" Click="Language_Click"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"/>
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Body ────────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="18,4,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="332"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Preview + actions -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,18,20,0">
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="14" Height="146">
                                <Image x:Name="PreviewImage" Width="118" Height="118"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <TextBlock x:Name="ColorNameText" FontSize="19" FontWeight="SemiBold" Margin="2,14,0,0"/>
                            <TextBlock x:Name="ColorHexText" Style="{StaticResource Caption}" Margin="3,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel Margin="20,0,20,18">
                                <Button x:Name="ApplyGlobalButton" Content="{loc:Text ApplyGlobal}"
                                        Style="{StaticResource PrimaryButton}" Click="ApplyGlobal_Click"/>
                                <Button x:Name="ApplyFolderButton" Content="{loc:Text ApplyFolders}"
                                        Style="{StaticResource GhostButton}" Margin="0,9,0,0"
                                        Click="ApplyFolder_Click"/>
                                <TextBlock Text="{loc:Text DragHint}" Style="{StaticResource Caption}" Margin="2,7,0,0"/>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>

                                <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}"
                                          Content="{loc:Text StartWithWindows}" Margin="0,0,0,12"
                                          Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
                                <CheckBox x:Name="RestartToggle" Style="{StaticResource Toggle}"
                                          Content="{loc:Text RestartExplorer}" Margin="0,0,0,12"
                                          Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <CheckBox x:Name="ShortcutToggle" Style="{StaticResource Toggle}"
                                          Content="{loc:Text ApplyShortcuts}"
                                          Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Palette + tags -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,10">
                        <TextBlock Text="{loc:Text PickColor}" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="PaletteCountText" Style="{StaticResource Caption}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PaletteHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ── Status ──────────────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="22,0,20,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="RestoreButton" Content="{loc:Text RestoreOriginal}"
                        Style="{StaticResource GhostButton}" Height="30" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Restore_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
